{
  "_comment": "Keys listed here are generated when .env leaves them empty. Keys in set_together are one secret split across variables: generating half of a key pair would produce a mismatch, so that is refused. Certificates are self-signed, for local development only; each certificate and its key are generated together.",
  "template": ".env.example",
  "target": ".env",
  "generators": {
    "POSTGRES_PASSWORD": "password",
    "INFLUXDB_ADMIN_PASSWORD": "password",
    "INFLUXDB_ADMIN_TOKEN": "token",
    "GRAFANA_ADMIN_PASSWORD": "password",
    "JWT_PRIVATE_KEY": "rsa_private_pem",
    "JWT_PUBLIC_KEY": "rsa_public_pem",
    "DEMO_ADMIN_PASSWORD": "password",
    "DEMO_ENGINEER_PASSWORD": "password",
    "DEMO_OPERATOR_PASSWORD": "password",
    "DEMO_VIEWER_PASSWORD": "password",
    "MQTT_PHYSICS_ENGINE_PASSWORD": "password",
    "MQTT_PLC_CONTROLLER_PASSWORD": "password",
    "MQTT_ALERT_MANAGER_PASSWORD": "password",
    "MQTT_HISTORIAN_PASSWORD": "password",
    "MQTT_API_GATEWAY_PASSWORD": "password",
    "MQTT_OPCUA_SERVER_PASSWORD": "password",
    "MQTT_MONITOR_PASSWORD": "password",
    "GATEWAY_DB_PASSWORD": "password",
    "ALARMS_DB_PASSWORD": "password",
    "WEB_TLS_CERT": "cert:web_tls",
    "WEB_TLS_KEY": "key:web_tls",
    "OPCUA_SERVER_CERT": "cert:opcua",
    "OPCUA_SERVER_KEY": "key:opcua"
  },
  "set_together": [
    [
      "JWT_PRIVATE_KEY",
      "JWT_PUBLIC_KEY"
    ],
    [
      "WEB_TLS_CERT",
      "WEB_TLS_KEY"
    ],
    [
      "OPCUA_SERVER_CERT",
      "OPCUA_SERVER_KEY"
    ]
  ],
  "certificates": {
    "web_tls": {
      "common_name": "localhost",
      "dns": [
        "localhost"
      ],
      "ips": [
        "127.0.0.1"
      ],
      "key": "ec-p256",
      "days": 825
    },
    "opcua": {
      "common_name": "CogniBoiler OPC UA server",
      "uris": [
        "urn:cogniboiler:opcua-server"
      ],
      "dns": [
        "localhost",
        "opcua-server"
      ],
      "ips": [
        "127.0.0.1"
      ],
      "key": "rsa-2048",
      "days": 825
    }
  }
}
