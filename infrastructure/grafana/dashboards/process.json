{
  "uid": "cogniboiler-process",
  "title": "Process",
  "description": "Main process values of the 300 MW unit, with scenario, fault and PLC events as annotations.",
  "tags": [
    "cogniboiler",
    "process"
  ],
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "links": [],
  "liveNow": false,
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "utc",
  "weekStart": "",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Scenarios and faults",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "target": {
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"simulation_events\" and r._field == \"text\")\n  |> keep(columns: [\"_time\", \"_value\", \"kind\", \"state\", \"severity\"])",
          "refId": "Anno"
        }
      },
      {
        "name": "PLC events",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "target": {
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"plc_events\" and r._field == \"text\")\n  |> keep(columns: [\"_time\", \"_value\", \"kind\", \"state\", \"severity\"])",
          "refId": "Anno"
        }
      },
      {
        "name": "Critical alarms",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "target": {
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"alarm_changes\" and r._field == \"text\")\n  |> filter(fn: (r) => r.severity == \"critical\" and r.state == \"ACTIVE_UNACK\")\n  |> keep(columns: [\"_time\", \"_value\", \"kind\", \"state\", \"severity\"])",
          "refId": "Anno"
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
