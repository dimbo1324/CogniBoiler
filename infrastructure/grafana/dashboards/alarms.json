  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Critical alarms",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "target": {
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"alarm_changes\" and r._field == \"text\")\n  |> filter(fn: (r) => r.severity == \"critical\" and r.state == \"ACTIVE_UNACK\")\n  |> keep(columns: [\"_time\", \"_value\", \"kind\", \"state\", \"severity\"])",
          "refId": "Anno"
        }
      },
      {
        "name": "PLC events",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "target": {
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"plc_events\" and r._field == \"text\")\n  |> keep(columns: [\"_time\", \"_value\", \"kind\", \"state\", \"severity\"])",
          "refId": "Anno"
        }
      }
    ]
  },
