# Local development settings for the Docker Compose stack and host-run services.
# Create .env from this file with:  python dev_tools_scripts_runner.py dev-secrets
# Empty secrets below are generated by that script. .env itself is never committed.

# PostgreSQL
POSTGRES_USER=cogniboiler
POSTGRES_PASSWORD=
POSTGRES_DB=cogniboiler
# The applications' own roles (migration 0004): no DDL, the audit log only appended to.
# POSTGRES_USER owns the tables and is used only by the migration job.
GATEWAY_DB_PASSWORD=
ALARMS_DB_PASSWORD=

# InfluxDB 2
INFLUXDB_ORG=cogniboiler
INFLUXDB_BUCKET=sensors
INFLUXDB_ADMIN_USER=cogniboiler
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_ADMIN_TOKEN=

# MQTT: one account per service; the broker refuses anonymous clients
MQTT_PHYSICS_ENGINE_PASSWORD=
MQTT_PLC_CONTROLLER_PASSWORD=
MQTT_ALERT_MANAGER_PASSWORD=
MQTT_HISTORIAN_PASSWORD=
MQTT_API_GATEWAY_PASSWORD=
MQTT_OPCUA_SERVER_PASSWORD=
MQTT_MONITOR_PASSWORD=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# API gateway: RS256 key pair (PEM) used to sign and verify JWTs
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# API gateway: demo users seeded on start (users admin, engineer, operator, viewer)
DEMO_ADMIN_PASSWORD=
DEMO_ENGINEER_PASSWORD=
DEMO_OPERATOR_PASSWORD=
DEMO_VIEWER_PASSWORD=

# API gateway run from the host (the Compose stack sets these itself). It refuses to start
# without DATABASE_URL; use the gateway's own role and GATEWAY_DB_PASSWORD from this file:
# DATABASE_URL=postgresql+asyncpg://cogniboiler_gateway:<GATEWAY_DB_PASSWORD>@localhost:5432/cogniboiler
# Optional limits, shown with their defaults: open WebSocket connections, and sign-in
# password hashes computed at the same time.
# WS_MAX_CONNECTIONS=200
# LOGIN_MAX_CONCURRENT_HASHES=4

# Console over HTTPS on 8443 (nginx): a self-signed certificate for localhost.
# Leave both empty to serve HTTP only.
WEB_TLS_CERT=
WEB_TLS_KEY=

# OPC UA application certificate (Basic256Sha256); without it the server makes a temporary one.
OPCUA_SERVER_CERT=
OPCUA_SERVER_KEY=
