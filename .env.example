# Local development settings for the Docker Compose stack and host-run services.
# Create .env from this file with:  python dev_tools_scripts_runner.py dev-secrets
# Empty secrets below are generated by that script. .env itself is never committed.

# PostgreSQL
POSTGRES_USER=cogniboiler
POSTGRES_PASSWORD=
POSTGRES_DB=cogniboiler

# InfluxDB 2
INFLUXDB_ORG=cogniboiler
INFLUXDB_BUCKET=sensors
INFLUXDB_ADMIN_USER=cogniboiler
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_ADMIN_TOKEN=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# API gateway: RS256 key pair (PEM) used to sign and verify JWTs
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# API gateway: demo users seeded on start (users admin, engineer, operator, viewer)
DEMO_ADMIN_PASSWORD=
DEMO_ENGINEER_PASSWORD=
DEMO_OPERATOR_PASSWORD=
DEMO_VIEWER_PASSWORD=
